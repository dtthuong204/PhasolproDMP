<?xml version="1.0" encoding="utf-8"?>
<!-- Chép file này thành AppSettings.secret.config (cùng thư mục) rồi dán 2 khóa reCAPTCHA vào.
     File AppSettings.secret.config nằm trong .gitignore, không đưa lên GitHub. -->
<appSettings>
  <add key="ReCaptchaSiteKey" value="" />
  <add key="ReCaptchaSecretKey" value="" />
</appSettings>
