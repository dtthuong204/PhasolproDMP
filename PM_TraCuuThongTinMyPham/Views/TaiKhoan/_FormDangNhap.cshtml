@model PM_TraCuuThongTinMyPham.Models.DangNhapVM

<!--Form đăng nhập dùng chung: trang chủ (chưa đăng nhập) và trang /TaiKhoan/DangNhap-->
<!--Bấm Đăng nhập thì xóa danh sách tra cứu còn trong tab (của người dùng trước)-->
@using (Html.BeginForm("DangNhap", "TaiKhoan", FormMethod.Post, new { @class = "auth-form", onsubmit = "try { sessionStorage.clear(); } catch (e) { }" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
    if (!String.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="notice notice-ok">@Model.ThongBao</div>
    }
    if (!String.IsNullOrEmpty(Model.Loi))
    {
        <div class="notice notice-error">@Model.Loi</div>
    }
    <label class="form-field">
        <span class="form-label">Tên đăng nhập hoặc email</span>
        <input class="form-input" type="text" name="TenDangNhap" value="@Model.TenDangNhap" autocomplete="username" required autofocus />
    </label>
    <label class="form-field">
        <span class="form-label">Mật khẩu</span>
        <input class="form-input" type="password" name="MatKhau" autocomplete="current-password" required />
    </label>
    <div class="auth-row">
        <label class="form-check"><input type="checkbox" name="LuuTaiKhoan" value="true" @(Model.LuuTaiKhoan ? "checked" : "") /> Lưu tài khoản</label>
        <details class="auth-forgot">
            <summary>Quên mật khẩu?</summary>
            <p>Liên hệ quản trị hệ thống để được đặt lại mật khẩu.</p>
        </details>
    </div>
    <button class="btn btn-primary auth-submit" type="submit">Đăng nhập</button>
    <p class="auth-foot">Chưa có tài khoản? <a href="@Url.Action("DangKy", "TaiKhoan")">Đăng ký</a></p>
}
