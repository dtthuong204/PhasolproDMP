@using PM_TraCuuThongTinMyPham.Models
@model SuaTaiKhoanVM
@{
    TaiKhoanRow tk = Model.TaiKhoan;
    bool laDoanhNghiep = tk.VaiTro == VaiTro.DoanhNghiep;
    //vai trò Admin được đổi qua lại (doanh nghiệp giữ nguyên vai trò)
    string[][] dsVaiTro = {
        new string[] { VaiTro.CaNhan, "Cá nhân" },
        new string[] { VaiTro.SoYTe, "Sở Y tế" },
        new string[] { VaiTro.Admin, "Quản trị" }
    };
}

@helper Xem(string nhan, string giaTri)
{
    <label class="form-field">
        <span class="form-label">@nhan</span>
        <input class="form-input" type="text" value="@giaTri" readonly tabindex="-1" />
    </label>
}

<!--Admin xem / sửa một tài khoản; khóa, đặt lại mật khẩu làm ở trang danh sách-->
<section class="reg-page">
    <h1 class="reg-title">Sửa tài khoản</h1>

    @if (!String.IsNullOrEmpty(Model.ThongBao))
    {
        <div class="notice notice-ok">@Model.ThongBao</div>
    }
    @if (Model.DSLoi.Count > 0)
    {
        <div class="notice notice-error">
            <ul class="reg-errors">
                @foreach (string loi in Model.DSLoi)
                {
                    <li>@loi</li>
                }
            </ul>
        </div>
    }

    <div class="reg-form">
        <section class="reg-section">
            <h2 class="reg-head">Thông tin chung</h2>
            <div class="form-grid">
                @Xem("Tên đăng nhập", tk.TenDangNhap + (Model.LaMinh ? " (bạn)" : ""))
                @Xem("Vai trò hiện tại", VaiTro.TenHienThi(tk.VaiTro))
                @Xem("Trạng thái", tk.DangHoatDong ? "Hoạt động" : "Đã khóa")
                @Xem("Ngày tạo", tk.NgayTao.ToString("dd/MM/yyyy HH:mm"))
                @Xem("Đăng nhập gần nhất", tk.LanDangNhapCuoi.HasValue ? tk.LanDangNhapCuoi.Value.ToString("dd/MM/yyyy HH:mm") : "-")
            </div>
        </section>

        @using (Html.BeginForm("SuaTaiKhoan", "QuanTri", FormMethod.Post, new { @class = "reg-form" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="ID" value="@Model.ID" />

            if (!laDoanhNghiep)
            {
                <section class="reg-section">
                    <h2 class="reg-head">Thông tin tài khoản</h2>
                    <div class="form-grid">
                        <label class="form-field">
                            <span class="form-label">@(tk.VaiTro == VaiTro.SoYTe ? "Tên đơn vị" : "Họ và tên")<span class="req">*</span></span>
                            <input class="form-input" type="text" name="HoTen" value="@Model.HoTen" required />
                        </label>
                        <label class="form-field">
                            <span class="form-label">Email</span>
                            <input class="form-input" type="email" name="Email" value="@Model.Email" placeholder="Nhập email" />
                        </label>
                        <label class="form-field">
                            <span class="form-label">Số điện thoại</span>
                            <input class="form-input" type="text" name="SoDienThoai" value="@Model.SoDienThoai" placeholder="Nhập số điện thoại" />
                        </label>
                        <label class="form-field">
                            <span class="form-label">Vai trò</span>
                            @if (Model.LaMinh)
                            {
                                <!--không tự đổi vai trò của chính mình-->
                                <select class="form-input" disabled title="Không tự đổi vai trò của tài khoản đang đăng nhập">
                                    <option>@VaiTro.TenHienThi(tk.VaiTro)</option>
                                </select>
                            }
                            else
                            {
                                <select class="form-input" name="VaiTro">
                                    @foreach (string[] vt in dsVaiTro)
                                    {
                                        <option value="@vt[0]" @(Model.VaiTro == vt[0] ? "selected" : "")>@vt[1]</option>
                                    }
                                </select>
                            }
                        </label>
                    </div>
                </section>
            }
            else
            {
                <p class="reg-note reg-note-top">Họ tên, email đăng nhập, số điện thoại của tài khoản lấy theo Người đại diện.</p>
                @Html.Partial("~/Views/TaiKhoan/_ThongTinDoanhNghiep.cshtml", Model.DoanhNghiep)
            }

            <div class="reg-buttons">
                <button class="btn btn-primary" type="submit">Lưu</button>
                <a class="btn btn-outline" href="@Url.Action("TaiKhoan")">Về danh sách</a>
            </div>
        }
    </div>
</section>

@section scripts {
    <script src="@Url.Content("~/Scripts/taikhoan.js")"></script>
}
