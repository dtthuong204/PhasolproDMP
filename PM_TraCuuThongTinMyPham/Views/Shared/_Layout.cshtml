<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Phasolpro DMP</title>

    <!--font Oswald (tiêu đề, logo) và Montserrat (nội dung) lấy từ Google Fonts-->
    @{
        //URL có ký tự @ nên để trong chuỗi C#, tránh Razor hiểu nhầm là code
        string fontUrl = "https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Oswald:wght@500;600;700&display=swap";
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="@fontUrl" />

    <!--file css chính của trang-->
    @{
        //gắn thời điểm sửa file vào đường dẫn: sửa CSS xong trình duyệt tự tải bản mới, không dùng bản cũ trong cache
        string phienBanCss = System.IO.File.GetLastWriteTime(Server.MapPath("~/Content/Site.css")).Ticks.ToString();
        //trang đặt ViewBag.BoCucUngDung = true thì dùng bố cục toàn màn hình (header + 2 vùng, không cuộn cả trang)
        bool boCucUngDung = (ViewBag.BoCucUngDung == true);
        //góc tài khoản theo người đang đăng nhập (server vẫn chặn từng trang bằng [PhanQuyen])
        bool daDangNhap = Request.IsAuthenticated;
        string vaiTro = PM_TraCuuThongTinMyPham.Models.NguoiDung.LayVaiTro(User);
        bool laAdmin = vaiTro == PM_TraCuuThongTinMyPham.Models.VaiTro.Admin;
    }
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")?v=@phienBanCss" />
</head>
<body class="@(boCucUngDung ? "app-page" : "")">
    <header class="topbar">
        <div class="container topbar-inner">
            <!--Logo, bấm vào thì về trang chủ-->
            <a class="brand" href="@Url.Action("Index", "Home")">Phasolpro DMP</a>

            <nav class="main-nav">
                <a class="nav-item @(ViewBag.ActiveTab == "danhmuc" ? "active" : "")" href="@Url.Action("Index", "DanhMuc")">Danh mục</a>
                <a class="nav-item @(ViewBag.ActiveTab == "tracuu" ? "active" : "")" href="@Url.Action("Index", "TraCuu")">Tra cứu</a>
                <!--chỉ Admin thấy (server vẫn chặn bằng [PhanQuyen(Roles = Admin)])-->
                @if (laAdmin)
                {
                    <a class="nav-item @(ViewBag.ActiveTab == "quantri" ? "active" : "")" href="@Url.Action("TaiKhoan", "QuanTri")">Tài khoản</a>
                }
            </nav>

            @if (daDangNhap)
            {
                <!--Tài khoản: bấm để mở menu Đổi mật khẩu / Đăng xuất (thẻ details tự mở/đóng, không cần JS)-->
                <details class="account-menu" id="menu-tai-khoan">
                    <summary class="account">
                        <span class="account-avatar">@PM_TraCuuThongTinMyPham.Models.NguoiDung.LayChuCaiDau(User)</span>
                        <span class="account-name">@PM_TraCuuThongTinMyPham.Models.NguoiDung.LayTenHienThi(User)</span>
                        <span class="account-caret">▾</span>
                    </summary>
                    <div class="account-drop">
                        <div class="account-drop-head">
                            <strong>@PM_TraCuuThongTinMyPham.Models.NguoiDung.LayTenHienThi(User)</strong>
                            <span>@User.Identity.Name · @PM_TraCuuThongTinMyPham.Models.VaiTro.TenHienThi(vaiTro)</span>
                        </div>
                        <a class="account-drop-item" href="@Url.Action("DoiMatKhau", "TaiKhoan")">Đổi mật khẩu</a>
                        @if (laAdmin)
                        {
                            <a class="account-drop-item" href="@Url.Action("TaiKhoan", "QuanTri")">Quản lý tài khoản</a>
                        }
                        <!--Đăng xuất: xóa luôn danh sách tra cứu lưu tạm trong tab-->
                        @using (Html.BeginForm("DangXuat", "TaiKhoan", FormMethod.Post, new { onsubmit = "try { sessionStorage.clear(); } catch (e) { }" }))
                        {
                            @Html.AntiForgeryToken()
                            <button class="account-drop-item account-logout" type="submit">Đăng xuất</button>
                        }
                    </div>
                </details>
            }
            else
            {
                <div class="account-guest">
                    <a class="btn btn-outline btn-sm" href="@Url.Action("DangKy", "TaiKhoan")">Đăng ký</a>
                    <a class="btn btn-primary btn-sm" href="@Url.Action("DangNhap", "TaiKhoan")">Đăng nhập</a>
                </div>
            }
        </div>
    </header>

    @if (boCucUngDung)
    {
        <!--Trang dạng ứng dụng (Danh mục, Tra cứu): chiếm đúng chiều cao màn hình, trang tự đặt footer trong khung bên phải-->
        <main class="app-main">
            @RenderBody()
        </main>
    }
    else
    {
        <!--Nội dung từng trang render trong main-->
        <main class="site-main">
            <div class="container">
                @RenderBody()
            </div>
        </main>

        @Html.Partial("_Footer")
    }

    @Scripts.Render("~/bundles/jquery")
    <script>
        // bấm ra ngoài menu tài khoản thì đóng menu
        $(document).on("click", function (e) {
            var menu = document.getElementById("menu-tai-khoan");
            if (menu && menu.open && !menu.contains(e.target))
                menu.open = false;
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
